# Echoes Configuration
# All operations default to local loopback (127.0.0.1)

# SQLite Database Location
ECHOES_DB_PATH=./data/echoes.db

# Ollama Local Service Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b

# Application Ports and Binding
# Local default: strictly binds to loopback (127.0.0.1)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Render / Remote Deployment Settings (Optional - auto-configured on Render)
# PORT=10000
# RENDER=true
# FRONTEND_URL=https://echoes-frontend.onrender.com
# ALLOWED_ORIGINS=https://echoes-frontend.onrender.com



# Echoes Frontend Environment Configuration
# -----------------------------------------------------------------------------
# Local Development:
# Leave VITE_API_BASE_URL blank. The Vite dev server will proxy requests to /api
# to http://127.0.0.1:8000 automatically, keeping everything on local loopback.
#
# Production / Render Static Site:
# Set VITE_API_BASE_URL to the public URL of your deployed Echoes backend.
# Render Blueprints automatically inject this using `fromService`.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=https://echoes-backend.onrender.com

